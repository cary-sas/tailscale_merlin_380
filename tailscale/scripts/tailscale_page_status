#!/bin/sh

TS="/koolshare/bin/tailscale"
TSD="/koolshare/bin/tailscaled"
IFACE="tailscale0"

fmt_bytes() {
  awk -v b="${1:-0}" 'BEGIN {
    split("B KiB MiB GiB TiB", u, " ");
    i = 1;
    while (b >= 1024 && i < 5) { b = b / 1024; i++ }
    if (i == 1) printf "%d %s", b, u[i];
    else printf "%.1f %s", b, u[i];
  }'
}

get_iface_ip() {
  if [ -x "$TS" ]; then
    "$TS" ip -4 2>/dev/null | head -n 1
    return
  fi

  ip addr show "$IFACE" 2>/dev/null | awk '/inet / { sub(/\/.*/, "", $2); print $2; exit }'
}

version="-"
[ -x "$TS" ] && version="$("$TS" version 2>/dev/null | head -n 1 | awk '{print $1}')"
[ -n "$version" ] || version="-"

pid="$(pidof tailscaled 2>/dev/null | awk '{print $1}')"
if [ -n "$pid" ]; then
  running="tailscaled ${version} 进程运行正常！（PID：${pid}）"
else
  running="tailscaled 未运行"
fi

tailnet="unknown"
if [ -x "$TS" ]; then
  if "$TS" status >/dev/null 2>&1; then
    tailnet="ok"
  else
    tailnet="error"
  fi
fi

printf 'CONTROL\t%s\t%s\n' "$running" "$tailnet"

if [ -d "/sys/class/net/${IFACE}" ]; then
  rx="$(cat "/sys/class/net/${IFACE}/statistics/rx_bytes" 2>/dev/null)"
  tx="$(cat "/sys/class/net/${IFACE}/statistics/tx_bytes" 2>/dev/null)"
  state="$(cat "/sys/class/net/${IFACE}/operstate" 2>/dev/null)"
  [ -n "$state" ] || state="up"
  ip4="$(get_iface_ip)"
  [ -n "$ip4" ] || ip4="-"
  [ "$state" = "unknown" ] && [ "$ip4" != "-" ] && state="up"

  printf 'IFACE\t%s\t%s\t%s\t%s\t%s\n' "$IFACE" "$ip4" "$(fmt_bytes "$rx")" "$(fmt_bytes "$tx")" "$state"
else
  printf 'IFACE\t%s\t-\t-\t-\tnot found\n' "$IFACE"
fi

echo "XU6J03M6"
